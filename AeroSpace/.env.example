# AeroSpace Environment Configuration Template

# Server Environment (development or production)
NODE_ENV=production
PORT=5000

# ── PRODUCTION HTTPS EMAIL DELIVERY (Required on Render Free Tier) ──
# Render blocks outbound SMTP ports 25, 465, and 587.
# Brevo REST API over HTTPS (Port 443) bypasses port blocking and sends real OTPs directly.
# Get free API key at: https://app.brevo.com/settings/keys/api (300 free emails/day)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=bikkinavijay0@gmail.com
BREVO_SENDER_NAME="AeroSpace Ground Control"

# (Optional alternative: Resend REST API over HTTPS)
# RESEND_API_KEY=re_your_resend_api_key_here

# ── LOCAL DEVELOPMENT SMTP (Gmail App Password fallback) ──
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="AeroSpace Ground Control" <your_email@gmail.com>

# ── FRONTEND API URL ──
# Connects React frontend directly to Render Express backend
VITE_API_URL=https://aerospec-api.onrender.com

# ── FIREBASE CLIENT CONFIGURATION ──
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
