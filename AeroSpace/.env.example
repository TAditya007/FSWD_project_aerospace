# AeroSpace Environment Configuration Template

# Server Environment (development or production)
NODE_ENV=production
PORT=5000

# ── SMTP SETUP FOR REAL OTP EMAILS (Gmail App Password) ──
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="AeroSpace Ground Control" <your_email@gmail.com>

# ── FRONTEND API URL ──
# Leave blank for local development (uses Vite proxy)
# In production on Firebase/Vercel, set to your Render backend URL:
# VITE_API_URL=https://your-backend-app.onrender.com

# ── FIREBASE CLIENT CONFIGURATION ──
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
